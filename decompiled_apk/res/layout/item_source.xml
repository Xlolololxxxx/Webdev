<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:background="?selectableItemBackground" android:layout_width="fill_parent" android:layout_height="@dimen/height_item"
  xmlns:android="http://schemas.android.com/apk/res/android">
